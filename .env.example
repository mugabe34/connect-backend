# Existing application settings (set these as usual for the backend)
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/connect
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Optional AI responses. Without OPENAI_API_KEY the assistant uses local Connect help articles.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint; defaults to the OpenAI chat completions endpoint.
AI_API_URL=

# Email escalation via SendGrid. The sender must be verified with SendGrid.
SENDGRID_API_KEY=
SUPPORT_FROM_EMAIL=
# Default recipients reuse the addresses on Connect's Contact page.
SUPPORT_EMAILS=mugabeherve7@gmail.com,hirwajules2000@gmail.com,tnsanzearnold@gmail.com
# Optional category-specific overrides (comma-separated addresses).
SUPPORT_EMAIL_BUYING=
SUPPORT_EMAIL_SELLING=
SUPPORT_EMAIL_ACCOUNT=
SUPPORT_EMAIL_MESSAGING=
SUPPORT_EMAIL_SAFETY=
SUPPORT_EMAIL_TECHNICAL=
SUPPORT_EMAIL_GENERAL=

# Optional Google sign-in (must match the frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Optional: seed the first admin account when the backend starts
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
